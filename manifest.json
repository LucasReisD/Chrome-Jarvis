{
  "manifest_version": 3,
  "name": "JARVIS — Assistente Pessoal Local",
  "version": "1.1.0",
  "description": "Assistente pessoal local com tarefas, anotações, links favoritos e ferramentas úteis.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Abrir JARVIS",
    "default_icon": {
      "16": "assets/icon.png",
      "48": "assets/icon.png",
      "128": "assets/icon.png"
    }
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  }
}
